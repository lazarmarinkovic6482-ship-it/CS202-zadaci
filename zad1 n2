1. Napraviti prozor koji prikazuje PieChart na osnovu unetih podataka (npr. raspodela ocena). Podaci se unose putem forme za unos.
import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.chart.PieChart;
import javafx.scene.control.*;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class OceneApp extends Application {

    int[] ocene = new int[6]; // ocene 1-5

    @Override
    public void start(Stage stage) {
        TextField unos = new TextField();
        unos.setPromptText("Unesite ocenu 1-5");

        Button dugme = new Button("Dodaj ocenu");
        PieChart pieChart = new PieChart();

        dugme.setOnAction(e -> {
            try {
                int ocena = Integer.parseInt(unos.getText());

                if (ocena >= 1 && ocena <= 5) {
                    ocene[ocena]++;
                    pieChart.getData().clear();

                    for (int i = 1; i <= 5; i++) {
                        if (ocene[i] > 0)
                            pieChart.getData().add(
                                new PieChart.Data("Ocena " + i, ocene[i])
                            );
                    }

                    unos.clear();
                }
            } catch (NumberFormatException ex) {
                new Alert(Alert.AlertType.ERROR, "Unesite broj od 1 do 5!").show();
            }
        });

        VBox root = new VBox(10, unos, dugme, pieChart);
        Scene scene = new Scene(root, 500, 400);

        stage.setTitle("Raspodela ocena");
        stage.setScene(scene);
        stage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
