1. Koristiti odgovarajuću kolekciju za sortiranje brojeva po rastućem redosledu i demonstrirati izvlačenje elemenata. Ispisati rezultate u glavnom programu.

import java.util.TreeSet;

public class Main {
    public static void main(String[] args) {
        TreeSet<Integer> brojevi = new TreeSet<>();

        // Dodavanje brojeva
        brojevi.add(25);
        brojevi.add(10);
        brojevi.add(42);
        brojevi.add(7);
        brojevi.add(18);

        // Ispis sortiranih brojeva
        System.out.println("Brojevi po rastućem redosledu:");
        System.out.println(brojevi);

        // Izvlačenje elemenata
        System.out.println("\nIzvlačenje elemenata:");

        while (!brojevi.isEmpty()) {
            int broj = brojevi.pollFirst();
            System.out.println("Izvučen broj: " + broj);
        }

        // Provera da li je kolekcija prazna
        System.out.println("\nKolekcija je prazna: " + brojevi.isEmpty());
    }
}
