
1. Implementirati generičku metodu T min(T[] niz) koja vraća najmanji element iz niza brojeva. Testirati rad funkcije u glavnom programu.

public class Main {

    public static <T extends Comparable<T>> T min(T[] niz) {
        T najmanji = niz[0];

        for (T element : niz) {
            if (element.compareTo(najmanji) < 0) {
                najmanji = element;
            }
        }

        return najmanji;
    }

    public static void main(String[] args) {
        Integer[] brojevi = {5, 2, 9, 1, 7};
        Double[] decimalniBrojevi = {3.5, 1.2, 8.4, 0.9};

        System.out.println("Najmanji Integer: " + min(brojevi));
        System.out.println("Najmanji Double: " + min(decimalniBrojevi));
    }
}
